<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net7.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AimPointGenerator</RootNamespace>
    <AssemblyName>AimPointGenerator</AssemblyName>
    <!-- Single-file publish: exe 한 개만 출력 -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <Target Name="ZipPublishExeOnly" AfterTargets="Publish">
    <PropertyGroup>
      <ZipFileName>AimPointGenerator-v1.1.3-win-x64.zip</ZipFileName>
      <ZipPath>$(ProjectDir)..\$(ZipFileName)</ZipPath>
      <ExeOnlyDir>$(ProjectDir)obj\publish-exe-only\</ExeOnlyDir>
    </PropertyGroup>
    <MakeDir Directories="$(ExeOnlyDir)" />
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFolder="$(ExeOnlyDir)" />
    <ZipDirectory SourceDirectory="$(ExeOnlyDir)" DestinationFile="$(ZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(ExeOnlyDir)" />
    <Message Importance="high" Text="Created: $(ZipPath) (exe only)" />
  </Target>

</Project>
