<UserControl x:Class="AimPointGenerator.Controls.AimPointItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource ThemeItemBackground}" CornerRadius="3" Padding="0" Margin="0,0,0,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="68"/>
                <ColumnDefinition Width="*" MinWidth="68"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="DragHandle" Grid.Column="0" Width="16" Margin="0" Cursor="SizeAll"
                    Background="{DynamicResource ThemeItemDragHandle}" BorderBrush="{DynamicResource ThemeBorderColor}" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <TextBlock Text="⋮⋮" FontSize="10" Foreground="{DynamicResource ThemeSectionHeaderForeground}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBox x:Name="TargetBox" Grid.Column="1" Margin="4" Padding="4" MinWidth="60"
                     Background="{DynamicResource ThemeTextBoxBackground}" Foreground="{DynamicResource ThemeTextBoxForeground}" CaretBrush="{DynamicResource ThemeTextBoxForeground}" BorderBrush="{DynamicResource ThemeTextBoxBorder}" BorderThickness="1"
                     ToolTip="Target distance (m)" PreviewMouseLeftButtonDown="NumericBox_PreviewMouseLeftButtonDown"/>
            <TextBox x:Name="ZeroingBox" Grid.Column="2" Margin="4" Padding="4" MinWidth="60"
                     Background="{DynamicResource ThemeTextBoxBackground}" Foreground="{DynamicResource ThemeTextBoxForeground}" CaretBrush="{DynamicResource ThemeTextBoxForeground}" BorderBrush="{DynamicResource ThemeTextBoxBorder}" BorderThickness="1"
                     ToolTip="Zeroing distance (m)" PreviewMouseLeftButtonDown="NumericBox_PreviewMouseLeftButtonDown"/>
            <TextBox x:Name="AimPositionBox" Grid.Column="3" Margin="4" Padding="4"
                     Background="{DynamicResource ThemeTextBoxBackground}" Foreground="{DynamicResource ThemeTextBoxForeground}" CaretBrush="{DynamicResource ThemeTextBoxForeground}" BorderBrush="{DynamicResource ThemeTextBoxBorder}" BorderThickness="1"
                     ToolTip="Point" PreviewMouseLeftButtonDown="NumericBox_PreviewMouseLeftButtonDown"/>
            <Button x:Name="MinMaxButton" Grid.Column="4" Content="Max" Width="50" Margin="4"
                    Foreground="White" BorderThickness="0"
                    Click="MinMaxButton_Click"/>
            <Button Grid.Column="5" Content="Delete" Width="40" Margin="4" Click="DeleteButton_Click"
                    Background="{DynamicResource ThemeButtonDelete}" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Border>
</UserControl>
