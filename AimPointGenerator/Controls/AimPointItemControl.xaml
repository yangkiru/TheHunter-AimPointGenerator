<UserControl x:Class="AimPointGenerator.Controls.AimPointItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#152515" CornerRadius="3" Padding="0" Margin="0,0,0,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="68"/>
                <ColumnDefinition Width="*" MinWidth="68"/>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="58"/>
                <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="DragHandle" Grid.Column="0" Width="16" Margin="0" Cursor="SizeAll"
                    Background="#1a3a1a" BorderBrush="#2d5a2d" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <TextBlock Text="⋮⋮" FontSize="10" Foreground="#7CCD7C" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBox x:Name="TargetBox" Grid.Column="1" Margin="4" Padding="4" MinWidth="60"
                     Background="#0d1f0d" Foreground="#90EE90" CaretBrush="#90EE90" BorderBrush="#2d5a2d" BorderThickness="1"
                     ToolTip="Target distance (m)"/>
            <TextBox x:Name="ZeroingBox" Grid.Column="2" Margin="4" Padding="4" MinWidth="60"
                     Background="#0d1f0d" Foreground="#90EE90" CaretBrush="#90EE90" BorderBrush="#2d5a2d" BorderThickness="1"
                     ToolTip="Zeroing distance (m)"/>
            <TextBox x:Name="AimPositionBox" Grid.Column="3" Margin="4" Padding="4"
                     Background="#0d1f0d" Foreground="#90EE90" CaretBrush="#90EE90" BorderBrush="#2d5a2d" BorderThickness="1"
                     ToolTip="Point"/>
            <Button x:Name="MinMaxButton" Grid.Column="4" Content="Max" Width="50" Margin="4"
                    Background="#2d5a2d" Foreground="White" BorderThickness="0"
                    Click="MinMaxButton_Click"/>
            <Button Grid.Column="5" Content="Delete" Width="40" Margin="4" Click="DeleteButton_Click"
                    Background="#5a2020" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Border>
</UserControl>
