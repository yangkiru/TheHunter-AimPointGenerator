<UserControl x:Class="AimPointGenerator.Controls.HueColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinWidth="108" MinHeight="80">
    <UserControl.Resources>
        <Style x:Key="SliderRepeatButtonStyle" TargetType="{x:Type RepeatButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RepeatButton}">
                        <Border Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Height" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="ThumbBorder"
                                CornerRadius="5"
                                Background="#2d5a2d"
                                BorderBrush="#2d5a2d"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#3d5a3d"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="ThumbBorder" Property="Background" Value="#3d5a3d"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HueSliderThumbStyle" TargetType="{x:Type Thumb}">
            <Setter Property="Width" Value="6"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Thumb}">
                        <Border x:Name="HueThumbBorder"
                                CornerRadius="3"
                                Background="#FFFFFF"
                                BorderBrush="#2d5a2d"
                                BorderThickness="1"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="HueThumbBorder" Property="Background" Value="#F2F2F2"/>
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="HueThumbBorder" Property="Background" Value="#E6E6E6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6"
                                    CornerRadius="3"
                                    Background="#0d1f0d"
                                    BorderBrush="#2d5a2d"
                                    BorderThickness="1"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThemedSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ThemedTransparentTrackSliderStyle" TargetType="{x:Type Slider}">
            <Setter Property="Height" Value="14"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Slider}">
                        <Grid VerticalAlignment="Center">
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderRepeatButtonStyle}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource HueSliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#0d1f0d" CornerRadius="3" Padding="6" BorderBrush="#2d5a2d" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <StackPanel Grid.Row="0" Margin="0,0,0,4">
                <TextBlock x:Name="LabelText" Text="Color" Foreground="#90EE90" FontSize="10"/>
                <StackPanel Orientation="Horizontal" Margin="0,3,0,0" VerticalAlignment="Center">
                    <Border x:Name="PreviewBorder"
                            Width="16"
                            Height="16"
                            CornerRadius="3"
                            Background="#808080"
                            BorderBrush="#2d5a2d"
                            BorderThickness="1"/>
                    <TextBlock x:Name="HexText"
                               FontSize="9"
                               Foreground="#7CCD7C"
                               VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Row="1" Margin="0,2,0,0">
                <TextBlock Text="Hue" Foreground="#7CCD7C" FontSize="9" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Grid Grid.Column="0" Margin="0,0,4,0">
                        <Border Height="12" CornerRadius="2" VerticalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FF0000" Offset="0"/>
                                    <GradientStop Color="#FFFF00" Offset="0.17"/>
                                    <GradientStop Color="#00FF00" Offset="0.33"/>
                                    <GradientStop Color="#00FFFF" Offset="0.5"/>
                                    <GradientStop Color="#0000FF" Offset="0.67"/>
                                    <GradientStop Color="#FF00FF" Offset="0.83"/>
                                    <GradientStop Color="#FF0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Slider x:Name="HueSlider" Minimum="0" Maximum="360" Value="120"
                                VerticalAlignment="Center" Background="Transparent" Style="{StaticResource ThemedTransparentTrackSliderStyle}"
                                ValueChanged="HueSlider_ValueChanged"/>
                    </Grid>
                    <TextBox x:Name="HueBox" Grid.Column="1" Text="120" Padding="2" FontSize="9"
                             Background="#0d1f0d" Foreground="#90EE90" BorderBrush="#2d5a2d"
                             TextChanged="HueBox_TextChanged" LostFocus="HueBox_LostFocus"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="2" Margin="0,4,0,0">
                <TextBlock Text="Saturation" Foreground="#7CCD7C" FontSize="9" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="SatSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="100" Style="{StaticResource ThemedSliderStyle}"
                            VerticalAlignment="Center" ValueChanged="SatSlider_ValueChanged"/>
                    <TextBox x:Name="SatBox" Grid.Column="1" Text="100" Padding="2" FontSize="9"
                             Background="#0d1f0d" Foreground="#90EE90" BorderBrush="#2d5a2d"
                             TextChanged="SatBox_TextChanged" LostFocus="SatBox_LostFocus"/>
                </Grid>
            </StackPanel>
            <StackPanel Grid.Row="3" Margin="0,4,0,0">
                <TextBlock Text="Value" Foreground="#7CCD7C" FontSize="9" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="ValSlider" Grid.Column="0" Minimum="0" Maximum="100" Value="100" Style="{StaticResource ThemedSliderStyle}"
                            VerticalAlignment="Center" ValueChanged="ValSlider_ValueChanged"/>
                    <TextBox x:Name="ValBox" Grid.Column="1" Text="100" Padding="2" FontSize="9"
                             Background="#0d1f0d" Foreground="#90EE90" BorderBrush="#2d5a2d"
                             TextChanged="ValBox_TextChanged" LostFocus="ValBox_LostFocus"/>
                </Grid>
            </StackPanel>
            <StackPanel x:Name="AlphaPanel" Grid.Row="4" Margin="0,4,0,0" Visibility="Collapsed">
                <TextBlock Text="Alpha" Foreground="#7CCD7C" FontSize="9" Margin="0,0,0,2"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="28"/>
                    </Grid.ColumnDefinitions>
                    <Slider x:Name="AlphaSlider" Grid.Column="0" Minimum="0" Maximum="255" Value="255" Style="{StaticResource ThemedSliderStyle}"
                            VerticalAlignment="Center" ValueChanged="AlphaSlider_ValueChanged"/>
                    <TextBox x:Name="AlphaBox" Grid.Column="1" Text="255" Padding="2" FontSize="9"
                             Background="#0d1f0d" Foreground="#90EE90" BorderBrush="#2d5a2d"
                             TextChanged="AlphaBox_TextChanged" LostFocus="AlphaBox_LostFocus"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
