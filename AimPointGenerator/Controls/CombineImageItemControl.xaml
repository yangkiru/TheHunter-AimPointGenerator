<UserControl x:Class="AimPointGenerator.Controls.CombineImageItemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource ThemeItemBackground}" CornerRadius="3" Padding="0" Margin="0,0,0,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*" MinWidth="0"/>
                <ColumnDefinition Width="48"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="DragHandle" Grid.Column="0" Width="16" Margin="0" Cursor="SizeAll"
                    Background="{DynamicResource ThemeItemDragHandle}" BorderBrush="{DynamicResource ThemeBorderColor}" BorderThickness="0,0,1,0"
                    MouseLeftButtonDown="DragHandle_MouseLeftButtonDown">
                <TextBlock Text="⋮⋮" FontSize="10" Foreground="{DynamicResource ThemeSectionHeaderForeground}" 
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="FileNameText" Grid.Column="1" Margin="4" Padding="4"
                       Foreground="{DynamicResource ThemeLabelForeground}" FontSize="10" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
            <Button Grid.Column="2" Content="Delete" Width="40" Margin="4" Click="DeleteButton_Click"
                    Background="{DynamicResource ThemeButtonDelete}" Foreground="White" BorderThickness="0"/>
        </Grid>
    </Border>
</UserControl>
