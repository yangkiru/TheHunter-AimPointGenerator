<Window x:Class="AimPointGenerator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="theHunter: Call of the Wild - AimPoint Generator"
        Height="656" Width="1173"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="#1a2a1a">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="564"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="AimPoint Data" FontSize="18" FontWeight="Bold" Foreground="#90EE90" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Made by yangkiru" Foreground="#7CCD7C" FontSize="10" HorizontalAlignment="Right"/>
                <TextBlock Text="version 1.1.1" Foreground="#7CCD7C" FontSize="10" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="412"/>
                <ColumnDefinition Width="193"/>
                <ColumnDefinition Width="532"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0d1f0d" CornerRadius="4" Padding="10" Margin="0,0,5,0" Height="549" VerticalAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="238"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0a150a" CornerRadius="3" Padding="10" Margin="0,0,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Scope Data" Foreground="#7CCD7C" FontWeight="Bold" Margin="0,0,0,6"/>
                            <StackPanel Grid.Row="1">
                                <TextBlock Text="Ammunition Name" Foreground="#90EE90" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="AmmunitionNameBox" Padding="6" Margin="0,0,0,10"
                                         Background="#0d1f0d" Foreground="#90EE90" CaretBrush="#90EE90" BorderBrush="#2d5a2d"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2">
                                <TextBlock Text="Effective Range (m)" Foreground="#90EE90" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="EffectiveRangeBox" Padding="6" Margin="0,0,0,10"
                                         Background="#0d1f0d" Foreground="#90EE90" CaretBrush="#90EE90" BorderBrush="#2d5a2d"/>
                            </StackPanel>
                            <StackPanel Grid.Row="3">
                                <TextBlock Text="Scope Name" Foreground="#90EE90" FontSize="11" Margin="0,0,0,2"/>
                                <TextBox x:Name="ScopeNameBox" Padding="6" Margin="0,0,0,0"
                                         Background="#0d1f0d" Foreground="#90EE90" CaretBrush="#90EE90" BorderBrush="#2d5a2d"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Background="#0a150a" CornerRadius="3" Padding="10,10,4,10" Margin="0,5,0,5">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Text="Aim Point Data" Foreground="#7CCD7C" FontWeight="Bold" Margin="0,0,0,4"/>
                            <Grid Grid.Row="1" Margin="0,0,0,4" Width="{Binding ElementName=AimPointScrollViewer, Path=ViewportWidth}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*" MinWidth="68"/>
                                    <ColumnDefinition Width="*" MinWidth="68"/>
                                    <ColumnDefinition Width="50"/>
                                    <ColumnDefinition Width="58"/>
                                    <ColumnDefinition Width="48"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="1" Text="Target(m)" Foreground="#7CCD7C" FontSize="10" HorizontalAlignment="Left" TextAlignment="Left"/>
                                <TextBlock Grid.Column="2" Text="Zeroing(m)" Foreground="#7CCD7C" FontSize="10" HorizontalAlignment="Left" TextAlignment="Left"/>
                                <TextBlock Grid.Column="3" Text="Point" Foreground="#7CCD7C" FontSize="10" HorizontalAlignment="Left" TextAlignment="Left"/>
                                <TextBlock Grid.Column="4" Text="Zoom" Foreground="#7CCD7C" FontSize="10" HorizontalAlignment="Left" TextAlignment="Left"/>
                                <TextBlock Grid.Column="5" Text="" Foreground="#7CCD7C" FontSize="10" HorizontalAlignment="Left" TextAlignment="Left"/>
                            </Grid>
                            <ScrollViewer x:Name="AimPointScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                          Margin="0,4,0,0" Padding="0,4,4,4">
                                <StackPanel x:Name="AimPointItemsPanel"/>
                            </ScrollViewer>
                            <Button Grid.Row="3" Content="Add Aim Point" Click="AddAimPoint_Click"
                                    Padding="10,6" Margin="0,12,0,0"
                                    Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0" HorizontalAlignment="Center">
                        <Button Content="Load Data" Click="LoadData_Click"
                                Padding="12,6" Margin="0,0,10,0" MinWidth="100"
                                Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Save" Click="SaveData_Click"
                                Padding="12,6" Margin="0,0,10,0" MinWidth="60"
                                Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        <Button Content="Save As" Click="SaveDataAs_Click"
                                Padding="12,6" Margin="0,0,10,0" MinWidth="120"
                                Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                    </StackPanel>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Stretch" Margin="12">
                <Button Content="Save Image" Click="SaveImage_Click"
                        Padding="20,12" Margin="0,0,0,12"
                        Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                <Border Background="#0a150a" CornerRadius="3" Padding="10,10,8,11" Margin="0,0,0,0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*" MinHeight="80"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Combine Images" Foreground="#7CCD7C" FontWeight="Bold" FontSize="11" Margin="0,0,0,4" HorizontalAlignment="Center"/>
                        <ScrollViewer x:Name="CombineScrollViewer" Grid.Row="1" VerticalScrollBarVisibility="Visible" HorizontalScrollBarVisibility="Disabled"
                                      Margin="0,4,0,0" Padding="0,4,4,4">
                            <StackPanel x:Name="CombineImagesPanel" Width="{Binding ElementName=CombineScrollViewer, Path=ViewportWidth}"/>
                        </ScrollViewer>
                        <StackPanel Grid.Row="2" Margin="0,8,0,0">
                            <Button Content="Select Images" Click="SelectCombineImages_Click"
                                    Padding="10,6" Margin="0,0,0,6"
                                    Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <TextBlock Text="Columns" Foreground="#90EE90" FontSize="10" Margin="0,0,0,2"/>
                            <TextBox x:Name="CombineColumnsBox" Text="4" Padding="6" Margin="0,0,0,6"
                                     Background="#0d1f0d" Foreground="#90EE90" CaretBrush="#90EE90" BorderBrush="#2d5a2d"/>
                            <Button Content="Combine &amp; Save" Click="CombineImages_Click"
                                    Padding="10,6" Margin="0,0,0,6"
                                    Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                            <Button Content="Open Directory" Click="OpenDirectory_Click"
                                    Padding="10,6"
                                    Background="#2d5a2d" Foreground="White" BorderThickness="0" Cursor="Hand"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <Border Grid.Column="2" Background="#0d1f0d" CornerRadius="4" Padding="10,10,10,16" Margin="5,0,5,5" VerticalAlignment="Top">
                <Grid Width="512" Height="523">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="21"/>
                        <RowDefinition Height="502"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="AimPoint Image" 
                               Foreground="#7CCD7C" FontSize="12" Margin="0,0,0,2"/>
                    <Border Grid.Row="1" Background="#0a150a" BorderBrush="#2d5a2d" BorderThickness="2"
                            Width="502" Height="502" HorizontalAlignment="Left" VerticalAlignment="Top">
                        <Image x:Name="OutputImage"
                               Stretch="UniformToFill"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#FF6B6B" FontSize="12" Margin="0,10,0,0"/>
    </Grid>
</Window>
